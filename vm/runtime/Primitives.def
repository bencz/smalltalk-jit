PRIMITIVE(AtomicArrayGetAndAdd, "AtomicArrayGetAndAddPrimitive", primAtomicArrayGetAndAdd)  // AtomicArray>>at: i getAndAdd: anInteger
PRIMITIVE(AtomicArrayGetAndSet, "AtomicArrayGetAndSetPrimitive", primAtomicArrayGetAndSet)  // AtomicArray>>at: i getAndSet: aValue
PRIMITIVE(AtomicCompareAndSet, "AtomicCompareAndSetPrimitive", primAtomicCompareAndSet)  // Atomic>>compareAndSet: expected with: newValue
